# Captured image data — large binary (~GB); kept out of the code repo.
# The folders remain on disk, just untracked.
captures/
captures_*/

# Raw frame files written by capture_timeseries.py, wherever its --out points.
# Multi-GB; the small contrast.csv and the JSON sidecars stay trackable.
frames.raw

# Live ROI geometry the viewer keeps in sync with its screen, for
# capture_timeseries.py to pick up. Per-machine session state, not source.
roi_state.json

